# {{ ansible_managed }}
[Unit]
Description=Apache Tomcat {{ tomcat_version }} (NGO Donation Portal backend)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User={{ tomcat_user }}
Group={{ tomcat_user }}
EnvironmentFile={{ ngo_env_file }}
Environment=CATALINA_HOME={{ tomcat_current }}
Environment=CATALINA_BASE={{ tomcat_current }}
Environment="CATALINA_OPTS=-Xms256m -Xmx512m"
ExecStart={{ tomcat_current }}/bin/catalina.sh run
# catalina.sh exits 143 on a normal SIGTERM shutdown.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
