# {{ ansible_managed }}
server {
    listen {{ ngo_http_port }} default_server;
    listen [::]:{{ ngo_http_port }} default_server;
    server_name _;

    root {{ ngo_web_root }};
    index index.html;

    # Client-side routes (react-router) fall back to the SPA entry point.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location {{ ngo_context_path }}/ {
        proxy_pass http://127.0.0.1:{{ tomcat_port }}{{ ngo_context_path }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
